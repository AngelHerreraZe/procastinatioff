/PLAN_MAESTRO.md
/PLAN_DESARROLLO.md
/plan-desarrollo/
/docs/
/diseno/
__pycache__/

/target/
**/node_modules/
**/build/
**/dist/
**/.gradle/
**/.kotlin/
**/local.properties
*.keystore
*.jks
*.p8
*.p12
*.pem
.env
.env.*
**/DerivedData/
.DS_Store
# ML models: downloaded by a script and verified by hash
/models/*.task
/models/*.onnx
/models/*.gguf
# Generated on every build (Rust core for Android and its bindings)
/android/app/src/main/jniLibs/
/android/app/src/main/java/uniffi/
# Tauri
/desktop/app/src-tauri/gen/
/desktop/app/src-tauri/binaries/
# Fuzzing
/core/fuzz/artifacts/
/core/fuzz/corpus/
/core/fuzz/target/
/android/verifier/src/main/jniLibs/
/android/verifier/src/main/java/uniffi/
/android/verifier/src/main/assets/models/
