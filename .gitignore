/android/app/src/main/jniLibs/
/android/app/src/main/java/uniffi/
# Tauri
/desktop/app/src-tauri/gen/
/desktop/app/src-tauri/binaries/
# Fuzzing
/core/fuzz/artifacts/
/core/fuzz/corpus/
/core/fuzz/target/
/android/verifier/src/main/jniLibs/
/android/verifier/src/main/java/uniffi/
/android/verifier/src/main/assets/models/
