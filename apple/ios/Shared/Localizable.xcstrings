{
  "sourceLanguage": "en",
  "strings": {
    "%lld more min today": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min más hoy"
          }
        }
      }
    },
    "A change of settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cambio de ajustes"
          }
        }
      }
    },
    "Adding apps relaxes your rules: it takes effect tomorrow when you wake up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir apps relaja tus reglas: rige desde mañana al despertar."
          }
        }
      }
    },
    "Allow %@ during focus": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir %@ en el enfoque"
          }
        }
      }
    },
    "Bedtime": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de dormir"
          }
        }
      }
    },
    "Calls keep working.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas siguen funcionando."
          }
        }
      }
    },
    "During focus only that task's apps are available.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante el enfoque solo están disponibles las apps de esa tarea."
          }
        }
      }
    },
    "Got it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendido"
          }
        }
      }
    },
    "No connection with your other devices. It will retry.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión con tus otros dispositivos. Se reintentará."
          }
        }
      }
    },
    "One of your devices has not been seen for a while": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno de tus dispositivos lleva un tiempo sin aparecer"
          }
        }
      }
    },
    "Only your guardian can add apps, when setting up this iPhone. You can ask them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir apps solo lo puede hacer tu tutor al configurar este iPhone. Puedes pedírselo."
          }
        }
      }
    },
    "Open ProcastinaciOFF": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ProcastinaciOFF"
          }
        }
      }
    },
    "Open ProcastinaciOFF to see what's left or use a pass.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre ProcastinaciOFF para ver qué te falta o usar un permiso."
          }
        }
      }
    },
    "Rest day today": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Día de descanso hoy"
          }
        }
      }
    },
    "Saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado."
          }
        }
      }
    },
    "Sleep %lld min later (changes the schedule)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dormir %lld min más tarde (cambia el horario)"
          }
        }
      }
    },
    "Something went wrong. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo falló. Inténtalo de nuevo."
          }
        }
      }
    },
    "Tap here to see your goals or use a pass.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca aquí para ver tus metas o usar un permiso."
          }
        }
      }
    },
    "The person you support no longer wants to need your approval": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona a la que acompañas ya no quiere necesitar tu aprobación"
          }
        }
      }
    },
    "The person you support used their recovery code": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona a la que acompañas usó su código de recuperación"
          }
        }
      }
    },
    "There are alerts from devices in your family": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay avisos de los dispositivos de tu familia"
          }
        }
      }
    },
    "There are alerts from the person you support": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay avisos de la persona a la que acompañas"
          }
        }
      }
    },
    "Time for your task": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora toca tu tarea"
          }
        }
      }
    },
    "You have requests from your family": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes solicitudes de tu familia"
          }
        }
      }
    },
    "You haven't met your goals yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no cumples tus metas"
          }
        }
      }
    },
    "Your request has an answer": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu solicitud tiene respuesta"
          }
        }
      }
    },
    "denied.already_completed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa meta ya está cumplida."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That goal is already done."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.auth_required": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero desbloquea con tu PIN, contraseña, patrón o huella."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock with your PIN, password, pattern or fingerprint first."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.cooldown": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera %lld min antes del siguiente permiso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait %lld min before the next pass."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.easy_pin": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese PIN es demasiado fácil de adivinar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That PIN is too easy to guess."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.guardian_only": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tu tutor puede relajar las reglas; puedes pedírselo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your guardian can relax the rules; you can ask them."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.invalid_code": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código incorrecto o caducado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong or expired code."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.invalid_domain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa no es una dirección web válida."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not a valid website address."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.invalid_plan": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan tiene metas incompletas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan has incomplete goals."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.locked": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Espera %lld min."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait %lld min."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.method_not_allowed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese método no se acepta para esta meta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That method is not accepted for this goal."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.method_not_set": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese método no está configurado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That method is not set up."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.needs_contact": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cambio necesita la aprobación de tu contacto de confianza."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change needs your trusted contact\\'s approval."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.no_contact": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero invita a un contacto de confianza."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite a trusted contact first."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.no_key_goal": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan necesita al menos una meta que desbloquee."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan needs at least one goal that unlocks."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.no_permits_left": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No quedan permisos hoy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No passes left today."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.not_configured": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay configuración."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no configuration yet."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.plan_laxer": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan de hoy solo se puede endurecer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's plan can only be made stricter."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.too_many_grants": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy ya no hay más concesiones sin red."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No more concessions without network today."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.too_many_requests": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes varias solicitudes esperando respuesta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have several requests waiting for an answer."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.unknown_goal": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta desconocida o inactiva hoy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown goal, or not active today."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.weak_password": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña necesita al menos 8 caracteres."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password needs at least 8 characters."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.weak_pattern": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El patrón necesita al menos 4 puntos distintos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pattern needs at least 4 different dots."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.weak_pin": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PIN necesita al menos 6 dígitos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN needs at least 6 digits."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.wrong_secret": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es correcto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not right."
          }
        }
      },
      "extractionState": "manual"
    },
    "denied.wrong_state": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible en este momento."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available right now."
          }
        }
      },
      "extractionState": "manual"
    }
  },
  "version": "1.0"
}
