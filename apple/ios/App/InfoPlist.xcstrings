{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To check your goals (for example, counting squats) on this iPhone. No image is ever recorded or sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para comprobar tus metas (por ejemplo, contar sentadillas) en este iPhone. Nunca se graba ni se envía ninguna imagen."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To confirm changes to your rules with Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para confirmar los cambios de tus reglas con Face ID."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To check workout goals with today's exercise minutes. Nothing else is read, nothing is written, and nothing leaves this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para revisar metas de ejercicio con los minutos de ejercicio de hoy. No se lee nada más, no se escribe nada y nada sale de este iPhone."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To sync with your other devices on your Wi-Fi, without servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sincronizar con tus otros dispositivos en tu wifi, sin servidores."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To dictate the summary of what you read. The audio is processed on this iPhone and not saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dictar el resumen de lo que leíste. El audio se procesa en este iPhone y no se guarda."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To turn your voice into text on this iPhone, without sending it to any server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para convertir tu voz en texto en este iPhone, sin enviarla a ningún servidor."
          }
        }
      }
    }
  },
  "version": "1.0"
}
