# ProcastinatiOFF agent (root). Plan 09 · A.4.
[Unit]
Description=ProcastinatiOFF agent
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/lib/procastinatioff/procastinatioff-agent service
Restart=always
RestartSec=1
# If the agent hangs (even SIGSTOP), systemd kills it at once: the kernel then allows every pending
# exec. SIGKILL, not the default SIGABRT: a stopped process does not receive SIGABRT, and every exec
# on the computer would wait until the stop timeout (90 s).
WatchdogSec=5s
WatchdogSignal=SIGKILL
# No core dumps either: the helper that writes them is an exec this agent would have to approve.
LimitCORE=0
# Master key, encrypted (TPM2 if there is one); systemd decrypts it in a private tmpfs.
LoadCredentialEncrypted=procastinatioff.master:/etc/credstore.encrypted/procastinatioff.master
StateDirectory=procastinatioff
StateDirectoryMode=0700
RuntimeDirectory=procastinatioff
RuntimeDirectoryMode=0755
# Hardening. NOT PrivateTmp: the exec guard must see paths exactly as users do (with a private
# /tmp, a program run from the real /tmp would not be recognized as a user folder).
NoNewPrivileges=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_KILL CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
